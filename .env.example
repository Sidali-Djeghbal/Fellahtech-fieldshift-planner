# ==============================================================================
# FieldShift Planner Backend — Environment Configuration Template
# Normative 40 variables per ENDPOINTS Section C + 7 isolated Companion Settings
# Copy to `.env` for Docker Compose or local runs and replace placeholder secrets.
# ==============================================================================

# --- Database & Redis (7 normative vars) --------------------------------------
DATABASE_URL=postgresql+asyncpg://fieldshift:CHANGE_ME_DB_PASSWORD@db:5432/fieldshift
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_URL=redis://redis:6379/0
ML_DATASET_DB_URL=postgresql://ml_reader:CHANGE_ME_ML_READER_PASSWORD@db:5432/fieldshift
ML_READER_PASSWORD=CHANGE_ME_ML_READER_PASSWORD
# TODO(OQ-D4): Verify production query timeout & connection cap with ML/DBA owners.
ML_DB_STATEMENT_TIMEOUT_MS=5000
ML_DB_CONNECTION_LIMIT=10

# --- Auth & JWT Keys (4 normative vars) ---------------------------------------
JWT_SECRET_KEY=CHANGE_ME_256BIT_JWT_SECRET_KEY_MINIMUM_32_CHARS
JWT_PREVIOUS_SECRET_KEY=
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=2592000

# --- Guest Quotas & Redis Rate Limits (10 normative vars) ---------------------
GUEST_SESSION_DAYS=7
GUEST_MAX_FARMS=3
GUEST_MAX_FIELDS_PER_FARM=5
GUEST_MAX_ANALYSES=10
GUEST_MAX_ML_REFUNDS=3
GUEST_BURST_PER_MIN=30
GUEST_CREATE_PER_IP_HOUR=5
RATE_LIMIT_CRUD_PER_MIN=60
RATE_LIMIT_ANALYSIS_PER_HOUR=10
ANALYSIS_PER_IP_HOUR=15

# --- External ML Service & Wire Transport (9 normative vars) ------------------
ML_SERVICE_URL=https://ml.fieldshift.internal
ML_SERVICE_API_KEY=CHANGE_ME_ML_SERVICE_SHARED_API_KEY
ML_SERVICE_PREVIOUS_API_KEY=
ML_TIMEOUT_SECONDS=60
ML_MAX_RETRIES=1
# TODO(OQ-4): Confirm exact uncompressed payload cap with ML team.
ML_MAX_PAYLOAD_BYTES=524288
ML_CATALOG_TIMEOUT_SECONDS=5
ML_HEALTH_TIMEOUT_SECONDS=3
ML_CATALOG_SYNC_HOURS=6

# --- Resilience, Breaker, Degraded Mode & Worker (9 normative vars) -----------
ML_CIRCUIT_BREAKER_THRESHOLD=5
ML_BREAKER_COOLDOWN_SECONDS=30
ML_MAX_CONCURRENT_REQUESTS=8
# TODO(OQ-8): Confirm max replay age and ADR-7 Deprecation/Sunset duration.
DEGRADED_MODE_MAX_AGE_HOURS=72
ALLOW_SYNC_WAIT=false
SYNC_WAIT_TIMEOUT_SECONDS=58
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=90
MAX_JOB_ATTEMPTS=2

# --- Web CORS (1 normative var -> total = 40 normative vars) ------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==============================================================================
# Companion Runtime Settings (7 Non-Spec Safety & Tuning Knobs — IMPL-018)
# Isolated from the 40 ENDPOINTS Section C normative contract variables.
# ==============================================================================
APP_ENV=production
ML_PROVIDER_MODE=auto
ML_HEALTH_CHECK_INTERVAL_SECONDS=30
# TODO(OQ-3): Numeric tolerance for SEM-04 farmer_input cross-checks.
SEM04_NUMERIC_TOLERANCE=0.001
TRUSTED_PROXY_CIDRS=
REDIS_FAIL_CLOSED=true
ML_DATASET_OWNER_ROLE=
