# API Transport Mode: "fixture" (default offline/sandbox when unset) or "live" (FastAPI /api/v1)
NEXT_PUBLIC_API_MODE=live

# Upstream FastAPI backend proxied by next.config.ts (/api/v1/:path*)
API_UPSTREAM_URL=http://localhost:8000

# Optional explicit cross-origin API base (requires CORS_ALLOWED_ORIGINS to include http://localhost:3000)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
